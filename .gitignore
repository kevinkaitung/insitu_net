# Python bytecode cache
__pycache__/
*.pyc

# macOS zip-extraction metadata (AppleDouble sidecar files from mpas_sub.zip,
# created on macOS - not training output, safe to delete)
__MACOSX/

# training outputs (checkpoints/images land under --output-dir;
# logs/ is the convention used in the README's sample command)
tmp/
logs/
wandb/
*.pth
*.pth.tar

# extracted sample dataset (regenerate via `unzip mpas_sub.zip`)
mpas_sub/
